---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.html_pages %}{% unless p.sitemap == false or p.noindex or p.url contains '404' %}{% if p.layout %}  <url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc></url>
{% endif %}{% endunless %}{% endfor %}{% for d in site.dogs %}  <url><loc>{{ site.url }}{{ d.url }}</loc></url>
{% endfor %}{% for d in site.products %}  <url><loc>{{ site.url }}{{ d.url }}</loc></url>
{% endfor %}{% for post in site.posts %}  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
{% endfor %}</urlset>
